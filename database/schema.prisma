// ─────────────────────────────────────────────────────────────────────────
// 4. PARTNER MARKETPLACE — CRM, TWO-WAY REFERRAL, PROJECT OPPORTUNITY,
//    BIDDING, COMMISSION LEDGER
//
// Partner is a NEW commercial/CRM identity layered over existing
// operational identities (Contractor, HotelManagementCompany) via nullable
// unique FKs — it does not replace, rename, or restructure either. See
// InteriorDesignCompany for a type with no legacy system to wrap.
//
// This "Referral" concept is intentionally NOT the existing `Referral`
// model above (that one is a guest-booking referral, a different, live,
// unrelated business flow) — hence PartnerReferral, a distinct name.
// ─────────────────────────────────────────────────────────────────────────

enum PartnerType {
  CONTRACTOR
  HOTEL_MANAGEMENT
  INTERIOR_DESIGN
  FURNITURE
  MAINTENANCE
  CLEANING
  APPLIANCES
  REAL_ESTATE
  HOSPITALITY_SERVICES
  OTHER
}

// Deliberately a separate enum from PartnerType, not a reuse of it — "what
// kind of company" vs "what services it actually offers" are different
// questions. Same member values today by convention only; this is what
// lets the two diverge later without a migration touching any other
// marketplace model.
enum PartnerServiceType {
  CONTRACTOR
  HOTEL_MANAGEMENT
  INTERIOR_DESIGN
  FURNITURE
  MAINTENANCE
  CLEANING
  APPLIANCES
  REAL_ESTATE
  HOSPITALITY_SERVICES
  OTHER
}

enum PartnerVerificationStatus {
  PENDING_REVIEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  INACTIVE
}

model Partner {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  partnerType        PartnerType
  // Sole authoritative legal/commercial verification status. Specialized
  // operational profiles (InteriorDesignCompany, etc.) deliberately have no
  // verification field of their own. Future service-specific sub-reviews
  // (portfolioReviewed, licenseReviewed, ...) are a deferred extension
  // point, not implemented now.
  verificationStatus PartnerVerificationStatus @default(PENDING_REVIEW) @map("verification_status")

  // Item 3: permanent, immutable, assigned once on approval (e.g.
  // "EGY-P-00027") — distinct from PartnerReferral.referralCode, which is
  // generated per individual referral event, not per Partner. Used to
  // build the referral URL (?partner=EGY-P-00027). Nullable until approved
  // — a PENDING_REVIEW partner has no code yet.
  partnerCode String? @unique @map("partner_code")

  companyName    String  @map("company_name")
  legalName      String? @map("legal_name")
  phone          String
  whatsappNumber String? @map("whatsapp_number")
  email          String
  website        String?
  governorate    String?
  cityId         String? @map("city_id")
  city           City?   @relation(fields: [cityId], references: [id], onDelete: SetNull)
  address        String?
  yearsOfExperience Int? @map("years_of_experience")
  employeeCount     Int? @map("employee_count")
  companyDescription String? @db.Text @map("company_description")

  // Nullable, unique links to existing operational identities — set for
  // exactly one (or neither, for a type with no legacy analogue) depending
  // on partnerType. Existing Contractor/HotelManagementCompany rows,
  // dashboards, auth, and workflows are entirely untouched by this link.
  contractorId String? @unique @map("contractor_id")
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  hotelManagementCompanyId String? @unique @map("hotel_management_company_id")
  hotelManagementCompany   HotelManagementCompany? @relation(fields: [hotelManagementCompanyId], references: [id], onDelete: SetNull)

  interiorDesignCompany InteriorDesignCompany?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  // Soft-delete only, no hard-delete endpoint ever exposed — combined with
  // Restrict below on every history-bearing relation, this is what
  // guarantees deleting/deactivating a Partner can never orphan or destroy
  // commercial history. Use SUSPENDED/INACTIVE verificationStatus instead
  // of deletion.
  deletedAt DateTime? @map("deleted_at")

  users       PartnerUser[]
  services    PartnerService[]
  leads       Lead[]
  referrals   PartnerReferral[]
  invitations ProjectPartnerInvitation[]
  bids        Bid[]
  commissions Commission[]
  documents   Document[]
  maintenanceContracts MaintenanceContract[]
  maintenanceRequests  MaintenanceRequest[]

  @@index([tenantId, partnerType])
  @@index([tenantId, verificationStatus])
  @@map("partners")
}

model PartnerService {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  partnerId String @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  serviceType PartnerServiceType @map("service_type")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([partnerId, serviceType])
  @@map("partner_services")
}

enum PartnerUserRole {
  OWNER
  MANAGER
  SALES
  ACCOUNTANT
  PROJECT_MANAGER
  ENGINEER
}

model PartnerUser {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  partnerId String @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      PartnerUserRole @default(OWNER)
  isPrimary Boolean @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  // No global @@unique([userId]): the existing User model already lets one
  // User hold multiple independent company profiles (Owner + Contractor +
  // HotelManagementCompany can coexist today via separate unique FKs), so
  // this doesn't newly forbid one User managing multiple Partners.
  @@unique([partnerId, userId])
  @@map("partner_users")
}

enum DesignPricingApproach {
  PER_SQM
  FIXED_FEE
  HOURLY
  PERCENTAGE_OF_PROJECT
  OTHER
}

model InteriorDesignCompany {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  partnerId String  @unique @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  companyName String? @map("company_name")
  designSpecialties String[] @map("design_specialties")
  designStyles      String[] @map("design_styles")
  projectTypes      String[] @map("project_types")
  serviceCities     City[]   @relation("InteriorDesignServiceCities")

  yearsOfExperience Int? @map("years_of_experience")
  teamSize          Int? @map("team_size")

  capability3dVisualization      Boolean @default(false) @map("capability_3d_visualization")
  capabilityAutoCad              Boolean @default(false) @map("capability_autocad")
  capabilityMoodBoard             Boolean @default(false) @map("capability_mood_board")
  capabilityMaterialSelection    Boolean @default(false) @map("capability_material_selection")
  capabilityExecutionSupervision Boolean @default(false) @map("capability_execution_supervision")
  capabilityDesignConsultation   Boolean @default(false) @map("capability_design_consultation")

  pricingApproach   DesignPricingApproach? @map("pricing_approach")
  minProjectSizeSqm Decimal? @db.Decimal(10, 2) @map("min_project_size_sqm")
  maxProjectSizeSqm Decimal? @db.Decimal(10, 2) @map("max_project_size_sqm")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("interior_design_companies")
