enum LeadSource {
  PARTNER_REFERRAL
  WEBSITE
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  COLD_CALL
  ADMIN
  EXISTING_CUSTOMER
  GOOGLE
  ORGANIC
  DIRECT
  OTHER
}
enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP
  VIEWING
  BOOKED
  NOT_INTERESTED
  NO_RESPONSE
  QUALIFIED
  CONVERTED
  LOST
  DO_NOT_CONTACT
}
enum LeadPropertyStatus {
  NOT_REGISTERED
  REGISTRATION_STARTED
  PENDING_REVIEW
  APPROVED
  REJECTED
  ACTIVE
}
enum DuplicateReviewStatus {
  PENDING
  CONFIRMED_DUPLICATE
  CONFIRMED_DISTINCT
  DISPUTED
}
model Lead {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  source    LeadSource
  partnerId String?  @map("partner_id")
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  // Marketing attribution (Item 12) — nullable, only populated when a lead
  // originates from a published Advertisement rather than the partner-CRM
  // flow this model was originally built for.
  advertisementId String? @map("advertisement_id")
  advertisement   Advertisement? @relation(fields: [advertisementId], references: [id], onDelete: SetNull)
  campaignId String? @map("campaign_id")
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")

  fullName String @map("full_name")
  phone    String
  whatsappNumber String? @map("whatsapp_number")
  email    String?
  governorate String?
  cityId   String? @map("city_id")
  city     City?   @relation(fields: [cityId], references: [id], onDelete: SetNull)
  address  String?

  leadStatus     LeadStatus @default(NEW) @map("lead_status")
  propertyStatus LeadPropertyStatus @default(NOT_REGISTERED) @map("property_status")

  assignedEmployeeId String? @map("assigned_employee_id")
  assignedEmployee   User?   @relation("LeadsAssigned", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  convertedOwnerId String? @map("converted_owner_id")
  convertedOwner   Owner?  @relation(fields: [convertedOwnerId], references: [id], onDelete: SetNull)

  duplicateOfLeadId String? @map("duplicate_of_lead_id")
  duplicateOfLead   Lead?   @relation("LeadDuplicates", fields: [duplicateOfLeadId], references: [id], onDelete: SetNull)
  duplicateLeads    Lead[]  @relation("LeadDuplicates")
  duplicateReviewStatus DuplicateReviewStatus? @map("duplicate_review_status")

  notes         String?   @db.Text
  lastContactAt DateTime? @map("last_contact_at")
  nextFollowUpAt DateTime? @map("next_follow_up_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // No deletedAt, no delete endpoint, ever, for this model — this absence
  // is the actual mechanism enforcing "never delete leads," not merely a
  // service-layer convention.

  events      LeadEvent[]
  followUps   FollowUp[]
  partnerReferral PartnerReferral?

  @@index([tenantId, leadStatus])
  @@index([tenantId, partnerId])
  @@index([tenantId, phone])
  @@map("leads")
}

model LeadEvent {
  id     String @id @default(uuid())
  leadId String @map("lead_id")
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  eventType   String
  description String  @db.Text
  actorUserId String? @map("actor_user_id")
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId])
  @@map("lead_events")
}

enum FollowUpReason {
  NOT_READY
  NEEDS_FINANCING
  NEEDS_FINISHING
  NEEDS_FAMILY_APPROVAL
  WAITING_FOR_CONSTRUCTION
  COMPARING_ALTERNATIVES
  PRICE_CONCERN
  WANTS_TO_RENT_LATER
  OTHER
}
model FollowUp {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  leadId   String @map("lead_id")
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  dueAt   DateTime @map("due_at")
  reason  FollowUpReason
  notes   String?
  completedAt DateTime? @map("completed_at")
  assignedToUserId String? @map("assigned_to_user_id")
  assignedToUser   User?   @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, dueAt])
  @@map("follow_ups")
}

enum PartnerReferralDirection {
  PARTNER_TO_EGYMOTELZ
  EGYMOTELZ_TO_PARTNER
}
enum PartnerReferralStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  DISPUTED
  CANCELLED
}

enum ReferralLifecycleStage {
  REFERRED
  REGISTERED
  VERIFIED
  PROPERTY_SUBMITTED
  PROPERTY_APPROVED
  UNIT_APPROVED
  ACTIVE
}
model PartnerReferral {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  referralCode String @unique @map("referral_code")
  direction    PartnerReferralDirection

  partnerId String  @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  leadId String? @unique @map("lead_id")
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  projectOpportunityId String? @map("project_opportunity_id")
  projectOpportunity   ProjectOpportunity? @relation(fields: [projectOpportunityId], references: [id], onDelete: SetNull)

  ownerId    String? @map("owner_id")
  owner      Owner?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  propertyId String? @map("property_id")
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  status PartnerReferralStatus @default(ACTIVE)

  // Item 4: the granular Owner-side lifecycle, tracked separately from
  // `status` above (which remains the referral's own commercial
  // active/expired/disputed state, unchanged). Once ownerLifecycleStage
  // reaches PROPERTY_SUBMITTED, the referral becomes locked (see below) —
  // enforced at the service layer, not by the schema itself.
  ownerLifecycleStage ReferralLifecycleStage @default(REFERRED) @map("owner_lifecycle_stage")
  lockedAt DateTime? @map("locked_at")
  lockedBy String?   @map("locked_by")

  // Server-computed and snapshotted at creation only — no controller ever
  // accepts these two as client input after creation. A later
  // SystemSetting("partner.referral_protection_months") change never
  // retroactively alters an already-issued referral's protection window.
  protectionMonths    Int      @map("protection_months")
  protectionExpiresAt DateTime @map("protection_expires_at")
  attributionSource   String?  @map("attribution_source")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events      PartnerReferralEvent[]
  commissions Commission[]

  @@index([tenantId, partnerId])
  @@index([tenantId, status])
  @@map("partner_referrals")
}

model PartnerReferralEvent {
  id                String @id @default(uuid())
  partnerReferralId String @map("partner_referral_id")
  partnerReferral   PartnerReferral @relation(fields: [partnerReferralId], references: [id], onDelete: Cascade)
  eventType   String
  description String  @db.Text
  actorUserId String? @map("actor_user_id")
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([partnerReferralId])
  @@map("partner_referral_events")
}

enum ProjectExecutionType {
  COMPETITIVE
  DIRECT_MATCH
}
enum ProjectOpportunityStatus {
  DRAFT
  OPEN_FOR_BIDS
  BIDDING_CLOSED
  EVALUATING
  SHORTLISTED
  AWARDED
  CANCELLED
}
model ProjectOpportunity {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  opportunityCode String @unique @map("opportunity_code")
  ownerId    String  @map("owner_id")
  owner      Owner   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  propertyId String? @map("property_id")
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  // Category of company needed — intentionally PartnerType (matched at
  // invitation time), not PartnerServiceType (a partner's own declared
  // service list, separate metadata — see PartnerService above).
  serviceType    PartnerType          @map("service_type")
  executionType  ProjectExecutionType @map("execution_type")

  title       String
  description String  @db.Text
  estimatedBudget Decimal? @db.Decimal(12, 2) @map("estimated_budget")
  currency    String  @default("EGP")
  requiredCompletionDate DateTime? @map("required_completion_date")
  locationCityId String? @map("location_city_id")
  locationCity   City?  @relation(fields: [locationCityId], references: [id], onDelete: SetNull)
  areaSqm     Decimal? @db.Decimal(10, 2) @map("area_sqm")
  unitCount   Int?     @map("unit_count")
  specialRequirements String? @db.Text @map("special_requirements")

  status      ProjectOpportunityStatus @default(DRAFT)
  bidDeadline DateTime? @map("bid_deadline")

  awardedBidId String? @unique @map("awarded_bid_id")
  awardedBid   Bid?    @relation("AwardedBid", fields: [awardedBidId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  invitations      ProjectPartnerInvitation[]
  bids             Bid[]             @relation("OpportunityBids")
  partnerReferrals PartnerReferral[]
  commissions      Commission[]
  documents        Document[]

  @@index([tenantId, status])
  @@index([tenantId, serviceType])
  @@map("project_opportunities")
}

enum InvitationStatus {
  INVITED
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}
model ProjectPartnerInvitation {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  projectOpportunityId String @map("project_opportunity_id")
  projectOpportunity   ProjectOpportunity @relation(fields: [projectOpportunityId], references: [id], onDelete: Cascade)
  partnerId String  @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  status     InvitationStatus @default(INVITED)
  invitedAt  DateTime @default(now()) @map("invited_at")
  respondedAt DateTime? @map("responded_at")

  // Private bidding (a partner never seeing another partner's invitation
  // or bid) is enforced server-side by every partner-facing query filtering
  // WHERE partnerId = req.partner.id — not by anything in this schema
  // itself. Flagged here so it isn't lost before the Phase 4 controllers.
  @@unique([projectOpportunityId, partnerId])
  @@map("project_partner_invitations")
}

enum BidStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  WINNING
  WITHDRAWN
  EXPIRED
}
model Bid {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  projectOpportunityId String @map("project_opportunity_id")
  projectOpportunity   ProjectOpportunity @relation("OpportunityBids", fields: [projectOpportunityId], references: [id], onDelete: Cascade)
  partnerId String  @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  status BidStatus @default(DRAFT)

  totalPrice Decimal @db.Decimal(12, 2) @map("total_price")
  currency   String  @default("EGP")
  estimatedDurationDays Int? @map("estimated_duration_days")
  proposedStartDate     DateTime? @map("proposed_start_date")
  paymentSchedule String? @db.Text @map("payment_schedule")
  scopeOfWork     String? @db.Text @map("scope_of_work")
  materialsSpec   String? @db.Text @map("materials_spec")
  warrantyMonths  Int?    @map("warranty_months")
  notes           String? @db.Text

  // Interior-design-relevant fields — nullable and generic enough that a
  // Contractor's bid simply leaves them unset. One Bid model, not a
  // parallel "InteriorDesignBid" — this is what lets them compete equally.
  designFee               Decimal? @db.Decimal(12, 2) @map("design_fee")
  executionSupervisionFee Decimal? @db.Decimal(12, 2) @map("execution_supervision_fee")
  conceptDesignIncluded    Boolean @default(false) @map("concept_design_included")
  moodBoardIncluded        Boolean @default(false) @map("mood_board_included")
  visualization3dIncluded  Boolean @default(false) @map("visualization_3d_included")
  autoCadDrawingsIncluded  Boolean @default(false) @map("autocad_drawings_included")
  revisionsIncluded        Int?    @map("revisions_included")

  submittedAt DateTime? @map("submitted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  awardedForOpportunity ProjectOpportunity? @relation("AwardedBid")
  commissions Commission[]
  documents   Document[]

  @@unique([projectOpportunityId, partnerId])
  @@map("bids")
}

enum CommissionRuleType {
  PERCENTAGE
  FIXED
}
model CommissionRule {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  direction   PartnerReferralDirection
  partnerType PartnerType?   @map("partner_type") // null = applies to all types; set = type-specific override
  ruleType    CommissionRuleType @map("rule_type")
  percentageValue Decimal? @db.Decimal(5, 2) @map("percentage_value")
  fixedAmount     Decimal? @db.Decimal(12, 2) @map("fixed_amount")
  currency    String  @default("EGP")
  isActive    Boolean @default(true) @map("is_active")
  effectiveFrom DateTime @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by")

  commissions Commission[]

  @@index([tenantId, direction, isActive])
  @@map("commission_rules")
}

enum CommissionStatus {
  PENDING
  ELIGIBLE
  APPROVED
  PROCESSING
  PAID
  CANCELLED
  DISPUTED
}
model Commission {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  partnerId String  @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  direction PartnerReferralDirection

  partnerReferralId    String? @map("partner_referral_id")
  partnerReferral      PartnerReferral?    @relation(fields: [partnerReferralId], references: [id], onDelete: SetNull)
  projectOpportunityId String? @map("project_opportunity_id")
  projectOpportunity   ProjectOpportunity? @relation(fields: [projectOpportunityId], references: [id], onDelete: SetNull)
  bidId String? @map("bid_id")
  bid   Bid?   @relation(fields: [bidId], references: [id], onDelete: SetNull)
  commissionRuleId String? @map("commission_rule_id")
  commissionRule   CommissionRule? @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)

  baseAmount          Decimal  @db.Decimal(12, 2) @map("base_amount")
  percentageApplied   Decimal? @db.Decimal(5, 2)  @map("percentage_applied")
  fixedAmountApplied  Decimal? @db.Decimal(12, 2) @map("fixed_amount_applied")
  calculatedAmount    Decimal  @db.Decimal(12, 2) @map("calculated_amount")
  currency            String   @default("EGP")

  // Once status reaches APPROVED or PAID, baseAmount/percentageApplied/
  // fixedAmountApplied/calculatedAmount/currency/partnerId/direction become
  // immutable — enforced at the service layer (no controller UPDATE path
  // touches these fields past that threshold). No existing adjustment-
  // ledger pattern was found elsewhere in this schema to mirror
  // (FinancialTransaction is a flat log, not a reversal mechanism) — a
  // future CommissionAdjustment model is the intended extension point if a
  // correction is ever needed, deliberately not built now.
  status       CommissionStatus @default(PENDING)
  eligibleAt   DateTime? @map("eligible_at")
  approvedAt   DateTime? @map("approved_at")
  approvedBy   String?   @map("approved_by")
  paidAt       DateTime? @map("paid_at")
  paymentReference String? @map("payment_reference")
  notes        String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, partnerId, status])
  @@index([tenantId, direction])
  @@map("commissions")
}

// ─────────────────────────────────────────────────────────────────────────
// 5. MARKETING — ADVERTISEMENTS, CAMPAIGNS
//
// Price/amenities are deliberately NOT duplicated here — the public
// apartment page reads Unit.pricePerNight and Unit.amenities directly at
// render time, per the explicit "use the existing pricing structure"
// instruction. Gallery images reference existing, already-approved
// UnitImage rows (isProfessional + reviewStatus, from the document-review
// work earlier this session) rather than a second image system.
// ─────────────────────────────────────────────────────────────────────────

enum AdvertisementStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  EXPIRED
  REJECTED
}

model Advertisement {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  unitId String @map("unit_id")
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  title            String
  shortDescription String? @map("short_description")
  fullDescription  String? @db.Text @map("full_description")
  // Public URL: /apartments/{property.city.key}/{slug} — city segment is
  // derived at request time from the unit's property/city, not stored here.
  slug String @map("slug")

  coverImageId String?   @map("cover_image_id")
  coverImage   UnitImage? @relation("AdvertisementCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  galleryImages AdvertisementImage[]

  featured   Boolean @default(false)
  campaignId String? @map("campaign_id")
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  canonicalUrl   String? @map("canonical_url")

  status      AdvertisementStatus @default(DRAFT)
  publishedAt DateTime? @map("published_at")
  expiresAt   DateTime? @map("expires_at")

  createdBy  String? @map("created_by")
  reviewedBy String? @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leads Lead[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, unitId])
  @@map("advertisements")
}

// Gallery ordering join — references existing, already-reviewed UnitImage
// rows rather than storing image data a second time.
model AdvertisementImage {
  id              String        @id @default(uuid())
  advertisementId String        @map("advertisement_id")
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  unitImageId     String        @map("unit_image_id")
  unitImage       UnitImage     @relation(fields: [unitImageId], references: [id], onDelete: Cascade)
  sortOrder       Int           @default(0) @map("sort_order")

  @@unique([advertisementId, unitImageId])
  @@map("advertisement_images")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

model Campaign {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name        String
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  status      CampaignStatus @default(DRAFT)
  budget      Decimal? @db.Decimal(12, 2)
  trackingId  String?  @map("tracking_id") // matches Lead.utmCampaign for attribution

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  advertisements Advertisement[]
  leads          Lead[]

  @@index([tenantId, status])
  @@map("campaigns")
}

// ─────────────────────────────────────────────────────────────────────────
// 6. MAINTENANCE — CONTRACTS AND REQUESTS
//
// MaintenanceRequest is a new, purpose-built model (Conflict 5) rather than
// repurposing SupportTicket, whose shape (generic subject + coarse status,
// no property/unit/partner linkage) doesn't fit this workflow — but it can
// optionally link one SupportTicket to reuse the existing message thread
// UI instead of building a second one.
// ─────────────────────────────────────────────────────────────────────────

enum MaintenanceContractType {
  MONTHLY
  ANNUAL
  PER_VISIT
  ON_DEMAND
  CUSTOM
}

enum MaintenanceContractStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  EXPIRED
  TERMINATED
}

model MaintenanceContract {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Item 15: partner must have the MAINTENANCE capability — enforced at
  // the service layer (checked against PartnerService), not by this FK.
  partnerId String  @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  ownerId   String  @map("owner_id")
  owner     Owner   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  // Item 16: scope. propertyId set = whole building; units[] set = specific
  // unit(s) within or across properties; portfolioWide = every property
  // this Owner has, present or future. All three are independently
  // optional so any combination the business needs is representable
  // without inventing a fourth "scope type" enum.
  propertyId     String?  @map("property_id")
  property       Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  portfolioWide  Boolean  @default(false) @map("portfolio_wide")
  units          MaintenanceContractUnit[]

  contractNumber String @map("contract_number")
  contractType   MaintenanceContractType @map("contract_type")
  startDate      DateTime @map("start_date")
  endDate        DateTime? @map("end_date")
  scope          String?  @db.Text
  serviceFrequency String? @map("service_frequency")
  fee            Decimal  @db.Decimal(12, 2)
  status         MaintenanceContractStatus @default(DRAFT)
  notes          String?  @db.Text

  createdBy  String?   @map("created_by")
  approvedBy String?   @map("approved_by")
  approvedAt DateTime? @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  maintenanceRequests MaintenanceRequest[]

  @@unique([tenantId, contractNumber])
  @@index([tenantId, partnerId])
  @@index([tenantId, status])
  @@map("maintenance_contracts")
}

model MaintenanceContractUnit {
  id         String @id @default(uuid())
  contractId String @map("contract_id")
  contract   MaintenanceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  unitId     String @map("unit_id")
  unit       Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([contractId, unitId])
  @@map("maintenance_contract_units")
}

enum MaintenanceRequestStatus {
  OPEN
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CONFIRMED
  CANCELLED
}

model MaintenanceRequest {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  unitId String @map("unit_id")
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  maintenanceContractId String? @map("maintenance_contract_id")
  maintenanceContract   MaintenanceContract? @relation(fields: [maintenanceContractId], references: [id], onDelete: SetNull)

  partnerId String? @map("partner_id")
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  // Optional link to the existing SupportTicket model — reuses its
  // Message[] thread instead of building a second messaging system.
  supportTicketId String?       @unique @map("support_ticket_id")
  supportTicket   SupportTicket? @relation(fields: [supportTicketId], references: [id], onDelete: SetNull)

  title       String
  description String? @db.Text
  status      MaintenanceRequestStatus @default(OPEN)

  assignedAt  DateTime? @map("assigned_at")
  acceptedAt  DateTime? @map("accepted_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  confirmedAt DateTime? @map("confirmed_at")
  cancelledAt DateTime? @map("cancelled_at")

  createdBy String? @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, partnerId])
  @@index([tenantId, unitId])
  @@map("maintenance_requests")
}
