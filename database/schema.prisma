// Two new keys used by the OTA pricing feature (no schema change needed —
// this model already supported arbitrary admin-configurable values):
//   "ota.markup_usd"   -> { "value": 11 }                          — the $11 OTA markup, admin-editable
//   "fx.usd_to_egp"     -> { "rate": <number>, "updatedAt": <iso> } — current USD->EGP rate, admin-editable
// Per confirmed decision: MVP keeps a single current rate here (no history
// table). If historical/rate-provider tracking is needed later, the
// upgrade path is additive — introduce a dedicated ExchangeRate model
// (rate + effectiveAt rows) and have PricingService read from that instead;
// nothing about this SystemSetting-based approach needs to be torn out,
// since Booking.otaMarkupAmount already stores the *computed* EGP amount
// per booking rather than the raw rate, so past bookings are unaffected
// either way.
model SystemSetting {
  id       String  @id @default(uuid())
  tenantId String? @map("tenant_id") // nullable = platform-wide default, overridable per tenant
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key      String
  value    Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@map("system_settings")
}

model Translation {
  id     String @id @default(uuid())
  key    String
  locale String
  value  String

  @@unique([key, locale])
  @@map("translations")
}

model MediaLibraryItem {
