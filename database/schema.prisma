  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  ownerApplicationId String? @map("owner_application_id")
  ownerApplication   OwnerApplication? @relation(fields: [ownerApplicationId], references: [id], onDelete: Cascade)
  propertyId         String? @map("property_id")
  property           Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contractorApplicationId String? @map("contractor_application_id")
  contractorApplication   ContractorApplication? @relation(fields: [contractorApplicationId], references: [id], onDelete: Cascade)
  hotelManagementCompanyApplicationId String? @map("hotel_management_company_application_id")
  hotelManagementCompanyApplication   HotelManagementCompanyApplication? @relation(fields: [hotelManagementCompanyApplicationId], references: [id], onDelete: Cascade)
  partnerId               String? @map("partner_id")
